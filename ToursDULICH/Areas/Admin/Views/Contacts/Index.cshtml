@model IEnumerable<ToursDULICH.Models.Contact>

@{
    ViewData["Title"] = "Quản lý Liên hệ";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 font-weight-bold text-dark">Hộp thư Liên hệ</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                <i class="fas fa-check"></i> @TempData["Message"]
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title"><i class="fas fa-envelope mr-2"></i>Danh sách tin nhắn khách hàng</h3>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th style="width: 5%">#ID</th>
                                <th style="width: 20%">Người gửi</th>
                                <th style="width: 20%">Chủ đề</th>
                                <th style="width: 40%">Nội dung lời nhắn</th>
                                <th style="width: 10%">Ngày gửi</th>
                                <th style="width: 5%" class="text-center">Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.ContactId</td>
                                        <td>
                                            <span class="font-weight-bold">@item.Name</span><br />
                                            <small class="text-muted">@item.Email</small>
                                        </td>
                                        <td>@item.Subject</td>
                                        <td>
                                            @* Hiển thị nội dung đầy đủ *@
                                            <span style="white-space: pre-line;">@item.Message</span>
                                        </td>
                                        <td>
                                            @* Nếu có cột CreatedAt thì hiển thị, nếu không thì để trống *@
                                            @(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "---")
                                        </td>
                                        <td class="text-center">
                                            <form asp-action="Delete" asp-route-id="@item.ContactId" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa tin nhắn này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger rounded-circle" title="Xóa">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-inbox fa-3x mb-3"></i><br />
                                        Hộp thư trống. Chưa có liên hệ nào.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>