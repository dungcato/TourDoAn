@model ToursDULICH.Models.BlogPost

@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-header">
    <div class="container-fluid"><div class="row mb-2"><div class="col-sm-6"><h1 class="m-0">Chỉnh sửa bài viết</h1></div></div></div>
</div>

<section class="content">
    <div class="container-fluid">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="PostId" />
            <div class="row">
                <div class="col-md-9">
                    <div class="card card-warning">
                        <div class="card-header"><h3 class="card-title">Nội dung</h3></div>
                        <div class="card-body">
                            <div class="form-group">
                                <label>Tiêu đề</label>
                                <input asp-for="Title" class="form-control" required />
                            </div>
                            <div class="form-group">
                                <label>Nội dung</label>
                                <textarea asp-for="Content" id="Content" class="form-control"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body">
                            <button type="submit" class="btn btn-warning btn-block font-weight-bold">
                                <i class="fas fa-save"></i> CẬP NHẬT
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-block mt-2">Hủy</a>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Ảnh đại diện</h3></div>
                        <div class="card-body text-center">
                            @{
                                string imgUrl = ViewBag.CurrentImage != "" ? ViewBag.CurrentImage : "/images/no-image.jpg";
                            }
                            <img src="@imgUrl" id="imgPreview" class="img-fluid mb-3" style="max-height: 200px;" />

                            <input type="hidden" name="FeatureImage" id="FeatureImage" value="@ViewBag.CurrentImage" />
                            <button type="button" class="btn btn-primary btn-sm" onclick="openDialog()">
                                <i class="fas fa-folder-open"></i> Đổi ảnh khác
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@{
    var summerNote = new ToursDULICH.Areas.Admin.Models.SummerNote("#Content");
}
<partial name="_SummerNote" model="summerNote" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function openDialog() {
            var fm = $('<div/>').dialogelfinder({
                baseUrl: "/Admin/lib/lib/elFinder/",
                url: '/Admin/el-finder-file-system/connector',
                lang: 'vi',
                width: 840, height: 450, destroyOnClose: true,
                getFileCallback: function (files, fm) {
                    $('#FeatureImage').val(files.url);
                    $('#imgPreview').attr('src', files.url);
                },
                commandsOptions: { getfile: { oncomplete: 'close', folders: false } }
            }).dialogelfinder('instance');
        }
    </script>
}