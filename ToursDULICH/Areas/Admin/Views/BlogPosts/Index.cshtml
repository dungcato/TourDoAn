@model IEnumerable<ToursDULICH.Models.BlogPost>

@{
    ViewData["Title"] = "Quản lý Tin Tức";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0 text-dark">Quản lý Tin Tức & Blog</h1></div>
            <div class="col-sm-6 text-right">
                <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> Viết bài mới</a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }

        <div class="card">
            <div class="card-body p-0">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th style="width: 5%">ID</th>
                            <th style="width: 10%">Hình ảnh</th>
                            <th style="width: 35%">Tiêu đề bài viết</th>
                            <th style="width: 15%">Tác giả</th>
                            <th style="width: 15%">Ngày đăng</th>
                            <th style="width: 20%">Chức năng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string thumb = (item.Images != null && item.Images.Any()) ? item.Images.First().Url : "/images/no-image.jpg";
                            <tr>
                                <td>@item.PostId</td>
                                <td><img src="@thumb" style="width: 60px; height: 40px; object-fit: cover; border-radius: 4px;" /></td>
                                <td class="font-weight-bold">@item.Title</td>
                                <td>@(item.Author?.FullName ?? "Admin")</td>
                                <td>@item.CreatedAt?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.PostId" class="btn btn-primary btn-sm"><i class="fas fa-edit"></i> Sửa</a>
                                    <form asp-action="Delete" asp-route-id="@item.PostId" method="post" class="d-inline" onsubmit="return confirm('Xóa bài này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Xóa</button>
                                    </form>
                                    <a href="/Blog/Detail/@item.PostId" target="_blank" class="btn btn-info btn-sm"><i class="fas fa-eye"></i> Xem</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>